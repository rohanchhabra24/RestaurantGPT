# Supabase project (Settings -> API in your Supabase dashboard).
# Use the Session Pooler connection string (Connect -> Direct tab -> Session
# pooler), not the direct db.<ref>.supabase.co host — the direct host only
# resolves to an IPv6 address, which many hosts/sandboxes can't route.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# No JWT secret needed — auth.py verifies tokens via this project's JWKS
# endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json), which works for
# both the newer asymmetric JWT Signing Keys and covers key rotation
# automatically. Only relevant if a project is still on the legacy shared
# HS256 secret exclusively (Settings -> API -> JWT Keys -> Legacy JWT
# Secret tab) with no signing keys migration — not this project's case.

# Anthropic (routing, SQL generation, synthesis, grounding, eval)
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (cascading — see product.md §2.5)
ROUTER_MODEL=claude-haiku-4-5
SQL_MODEL=claude-sonnet-5
SYNTHESIS_MODEL=claude-sonnet-5

# Per-tenant rate limit (Postgres-backed, applies once authenticated + onboarded)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500

# Per-IP rate limits (slowapi, in-memory, applies even to unauthenticated/
# pre-onboarding requests — the bot/scraping and repeated-signup defense).
# Defaults shown; override only if these are too strict/loose for your traffic.
# IP_RATE_LIMIT_DEFAULT=60/minute
# IP_RATE_LIMIT_ACCOUNT_CREATE=5/hour
# IP_RATE_LIMIT_AI=15/minute

# Alert-only — never blocks a tenant, just flags it in Insights
COST_ALERT_THRESHOLD_USD=20.0

# Used only by seed.py and the CI eval harness (backend/eval/run_eval.py) —
# no API route trusts this, restaurant_id always comes from the
# authenticated JWT. See README for how to link your own test account to
# this seeded restaurant.
DEMO_RESTAURANT_ID=00000000-0000-0000-0000-000000000001

# Anomaly-scan sensitivity and trend-window sizes (days) — tune without a
# redeploy. Defaults shown.
# ANOMALY_DELTA_THRESHOLD_PCT=15.0
# ANOMALY_MIN_SAMPLE_SIZE=3
# INVESTIGATOR_RECENT_WINDOW_DAYS=7
# INVESTIGATOR_BASELINE_WINDOW_DAYS=28

# Comma-separated frontend origin(s) allowed by CORS. Set this to your real
# deployed frontend URL(s) in production — the default only covers local dev.
# CORS_ALLOWED_ORIGINS=https://app.yourrestaurantgpt.com

# Set true only if this process itself terminates TLS, or sits behind a
# proxy that forwards the original request scheme faithfully. Most managed
# platforms (Render/Fly/behind a load balancer) already redirect to HTTPS at
# that layer — enabling this in front of one would misfire on the internal
# plain-HTTP hop between the proxy and this process.
# FORCE_HTTPS=true

# Live Feed integration (see docs/live-feed-data-source.md) — this backend's
# own publicly reachable URL, used as the default source for the daily
# order-feed sync (POST /api/ingest/live-feed/sync). Set this to your real
# deployed backend URL once you deploy; localhost is fine for local dev.
# PUBLIC_API_BASE_URL=https://api.yourrestaurantgpt.com

# Shared secret enabling POST /api/ingest/live-feed/sync-all — what a daily
# scheduled job (e.g. GitHub Actions cron) calls to sync every restaurant's
# feed without a per-user login. Leave unset to keep that endpoint disabled.
# CRON_SYNC_SECRET=some-long-random-string
