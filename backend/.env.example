# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Settings -> API -> JWT Settings -> "JWT Secret" (legacy shared HS256 secret).
# Required for app/auth.py to verify tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic (routing, SQL generation, synthesis, grounding, eval)
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (cascading — see product.md §2.5)
ROUTER_MODEL=claude-haiku-4-5
SQL_MODEL=claude-sonnet-5
SYNTHESIS_MODEL=claude-sonnet-5

# Per-tenant rate limit
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500

# Alert-only — never blocks a tenant, just flags it in Insights
COST_ALERT_THRESHOLD_USD=20.0

# Used only by seed.py (no API route trusts this — restaurant_id always
# comes from the authenticated JWT). See README for how to link your own
# test account to this seeded restaurant.
DEMO_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
