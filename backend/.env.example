# Supabase project (Settings -> API in your Supabase dashboard).
# Use the Session Pooler connection string (Connect -> Direct tab -> Session
# pooler), not the direct db.<ref>.supabase.co host — the direct host only
# resolves to an IPv6 address, which many hosts/sandboxes can't route.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# No JWT secret needed — auth.py verifies tokens via this project's JWKS
# endpoint (SUPABASE_URL + /auth/v1/.well-known/jwks.json), which works for
# both the newer asymmetric JWT Signing Keys and covers key rotation
# automatically. Only relevant if a project is still on the legacy shared
# HS256 secret exclusively (Settings -> API -> JWT Keys -> Legacy JWT
# Secret tab) with no signing keys migration — not this project's case.

# Anthropic (routing, SQL generation, synthesis, grounding, eval)
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers (cascading — see product.md §2.5)
ROUTER_MODEL=claude-haiku-4-5
SQL_MODEL=claude-sonnet-5
SYNTHESIS_MODEL=claude-sonnet-5

# Per-tenant rate limit
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500

# Alert-only — never blocks a tenant, just flags it in Insights
COST_ALERT_THRESHOLD_USD=20.0

# Used only by seed.py (no API route trusts this — restaurant_id always
# comes from the authenticated JWT). See README for how to link your own
# test account to this seeded restaurant.
DEMO_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
