# Settings -> API in your Supabase dashboard. The anon/public key is safe
# to expose client-side — it only ever acts as the signed-in user via RLS,
# same as any Supabase frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Powers the landing page's "Book a demo" dialog (contact form + call
# request) — see src/lib/emailjs.js. Free account at emailjs.com: create
# an email service, then a template whose variables match what
# BookDemoDialog.jsx sends (from_name, from_email, restaurant_name, phone,
# interest, message, requested_date, requested_time). Left unset, the
# dialog shows an inline "not set up yet" message instead of failing
# silently.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
